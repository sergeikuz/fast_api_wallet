# Database connection
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/wallet_db

# SQL query logging (set to true for debugging)
ECHO_SQL=false

# Connection pool settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# API authentication (leave empty to disable)
API_KEY=

# CORS allowed origins (comma-separated)
CORS_ORIGINS=*

# Test database overrides (optional)
TEST_PG_USER=postgres
TEST_PG_PASSWORD=postgres
TEST_PG_HOST=localhost
TEST_PG_PORT=5432
